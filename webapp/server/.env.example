# Configuración del servidor. Copia a .env (no se versiona) solo si arrancas con `npm start` o con Docker.
# Con `npm run demo` / `npm run empezar` desde la raíz NO hace falta: ya usan el modo local.

PORT=3000
# Dónde vive tu base de datos. Haz copia de seguridad de ese fichero.
DB_PATH=./datos/finanzas.sqlite
# Directorio con la interfaz compilada (npm run build en webapp/web). Vacío = solo API.
WEB_DIR=../web/dist

# Las personas del hogar: id:Nombre separadas por comas. El id se guarda en los datos (titular, paro),
# así que no lo cambies una vez tengas datos. Vacío = la familia de ejemplo (ana:Ana,luis:Luis).
PERSONAS=ana:Ana,luis:Luis

# Autenticación:
#   local      -> tu ordenador, sin login; solo escucha en 127.0.0.1 (recomendado)
#   cloudflare -> acceso remoto detrás de Cloudflare Access (ver docs/instalacion.md, acceso desde el móvil)
#   dev        -> solo para desarrollo y tests (exige NODE_ENV=development)
AUTH_MODE=local
# Nombre con el que firmas los escenarios en modo local (opcional).
AUTH_LOCAL_NOMBRE=
# Solo en modo local y solo para Docker (ver docker-compose.yml). Nunca lo uses para abrir la app a tu red.
HOST=

# --- solo con AUTH_MODE=cloudflare ---
CF_TEAM_DOMAIN=
CF_AUD=
# email:Nombre por persona autorizada, separados por comas
ALLOWED_EMAILS=
# token de servicio de solo lectura (opcional)
SYNC_CLIENT_ID=

# --- solo con AUTH_MODE=dev ---
NODE_ENV=
AUTH_DEV_EMAIL=
AUTH_DEV_NOMBRE=
